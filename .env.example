# ── IronTrack environment configuration ──────────────────────────────
# Copy this file to `.env` and fill in the values you need:
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
# Leave a key empty to disable the feature it controls.

# Flask session signing key. If unset, one is auto-generated into
# `.secret_key` on first start (a stable random key will persist there).
SECRET_KEY=

# Groq API key — powers the IronBot AI assistant and AI-generated exercise
# details (https://console.groq.com)
GROQ_API_KEY=

# Google Gemini API key — optional helper for alternative AI workout
# generation (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gmail account used to send transactional email (password reset,
# verification, delete codes). MAIL_USERNAME + MAIL_PASSWORD together
# enable Flask-Mail. Use an app password, not your normal login password.
MAIL_USERNAME=
MAIL_PASSWORD=

# Google OAuth credentials for "Sign In with Google"
# (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URIs:
#   local:  http://127.0.0.1:5000/login/google/authorized
#   prod:   https://your-domain.com/login/google/authorized
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of admin emails with access to the feedback inbox
# at /admin/feedback.
ADMIN_EMAILS=

# Canonical site URL used in SEO meta tags, e.g. https://irontrack.app
SITE_URL=